faf_version: "3.0"
project:
  name: faf-trinity
  goal: The chassis for context, memory & agent in MCP — three IANA-registered formats, one MCP server.
  main_language: TypeScript
  type: mcp
stack:
  runtime: Node.js
  build: TypeScript (tsc)
  backend: Node.js (stdio MCP server)
  api_type: MCP (JSON-RPC 2.0 over stdio)
  frontend: slotignored  # no UI layer — stdio reference implementation
  css_framework: slotignored  # no UI
  ui_library: slotignored  # no UI
  state_management: slotignored  # stateless server, memory lives in project.fafm
  database: slotignored  # no database — memory is a file, not a DB
  connection: slotignored  # no database
  hosting: slotignored  # reference implementation, not a deployed service
  cicd: slotignored  # not wired up yet — Phase 5
tech_stack: [TypeScript, "@modelcontextprotocol/sdk"]
human_context:
  who: MCP host/server implementers who want context, memory, and agent identity without inventing their own ad-hoc shape
  what: A minimal reference MCP server exposing .faf (context), .fafm (memory), and .fafa (agent identity) via two mechanisms already proven live in production — MCP Server Card _meta and a self-published ai-catalog.json
  why: MCP servers today have no standard answer to "who am I, what do I remember, what's my project" — faf.one/context.faf.one already runs this pattern in production, but that's a full SvelteKit app, not something forkable. This extracts the minimal pattern.
  where: github.com/Wolfe-Jam/faf-trinity
  when: "2026-08-12"
  how: Phase 1 of 5 — scaffold + real artifacts. See PLAN.md in PLANET-FAF/07-PROJECTS/faf-trinity/ for the full build plan.
key_files: [package.json, README.md, tsconfig.json]
