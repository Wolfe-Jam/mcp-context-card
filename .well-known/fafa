# Agent identity card (.fafa) — mcp-context-card's own identity
# Media type: application/vnd.fafa+yaml
# This is the identity concern's worked example: `whoami` reads this file,
# and it's the third entry in the Server Card _meta block and ai-catalog.
# A deployment pointed at a real project replaces it with that agent's identity.

version: "1.0"
agent:
  name: "mcp-context-card"
  displayName: "mcp-context-card"
  vendor: "io.github.wolfe-jam"
  version: "0.5.1"
  description: >-
    An MCP server that makes a project's context (AGENTS.md), cross-session
    memory, and identity discoverable to any MCP client, through the Server
    Card _meta block and a self-published ai-catalog.json.
  status: "published"
  license: "MIT"
