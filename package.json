{
  "name": "mcp-context-card",
  "version": "0.5.0",
  "description": "Reference MCP server: project context, persistent memory, and agent identity — through the two exposure surfaces already in the ecosystem (Server Card _meta, ai-catalog sibling entries).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server-card",
    "ai-catalog",
    "project-context",
    "agent-memory",
    "agent-identity"
  ],
  "author": "wolfejam",
  "license": "MIT",
  "type": "module",
  "private": true,
  "//private": "flip to false at publish time — GO-gated. prepublishOnly is the build/test latch.",
  "bin": {
    "mcp-context-card": "dist/bin.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "project.faf",
    "project.fafm",
    ".well-known",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test",
    "start": "node dist/bin.js",
    "start:http": "node dist/bin.js --http",
    "dev": "tsx src/bin.ts",
    "demo": "tsx demo.ts",
    "catalog": "tsx src/catalog-gen.ts",
    "catalog:check": "tsx src/catalog-gen.ts && git diff --exit-code -- .well-known/ai-catalog.json",
    "card": "tsx src/card-gen.ts",
    "card:check": "tsx src/card-gen.ts && git diff --exit-code -- docs/card.html",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"demo.ts\" --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=80 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents-md-facts": "^0.1.0",
    "hono": "^4.13.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfe-Jam/mcp-context-card.git"
  },
  "homepage": "https://github.com/Wolfe-Jam/mcp-context-card"
}
