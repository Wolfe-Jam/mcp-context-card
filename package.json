{
  "name": "mcp-context-card",
  "version": "1.7.0",
  "mcpName": "io.github.Wolfe-Jam/mcp-context-card",
  "description": "The essential MCP components for a project's context (AGENTS.md), cross-session memory, and identity — a base MCP on its own, or a drop-in extension for any existing MCP server. Discoverable through the Server Card _meta block and ai-catalog.json sibling entries.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents-md",
    "server-card",
    "ai-catalog",
    "project-context",
    "agent-memory",
    "agent-identity"
  ],
  "author": "James Wolfe",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "mcp-context-card": "dist/bin.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "project.faf",
    "project.fafm",
    ".well-known",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "version:check": "node scripts/check-versions.mjs",
    "engines:check": "node scripts/check-engines.mjs",
    "faf:check": "node scripts/check-faf-consistency.mjs",
    "faf:nudge": "node scripts/faf-drift-nudge.mjs",
    "prepublishOnly": "npm run clean && npm run version:check && npm run engines:check && npm run faf:check && npm run build && npm run typecheck && npm test",
    "start": "node dist/bin.js",
    "start:http": "node dist/bin.js --http",
    "dev": "tsx src/bin.ts",
    "demo": "tsx demo.ts",
    "catalog": "tsx src/catalog-gen.ts",
    "catalog:check": "tsx src/catalog-gen.ts && git diff --exit-code -- .well-known/ai-catalog.json",
    "card": "tsx src/card-gen.ts",
    "card:check": "tsx src/card-gen.ts && git diff --exit-code -- docs/card.html docs/index.html docs/card-light.html docs/card-dark.html",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"demo.ts\" --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=80 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "wjttc": "node --import tsx --test --test-reporter=spec test/wjttc.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "agent-business-card": "^0.1.0",
    "agents-md-facts": "^0.1.0",
    "hono": "^4.13.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfe-Jam/mcp-context-card.git"
  },
  "homepage": "https://github.com/Wolfe-Jam/mcp-context-card"
}
